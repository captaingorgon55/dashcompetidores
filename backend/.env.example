# ─── Competitor Dashboard — Configuración ───────────────────────
# Copia este archivo como .env y ajusta los valores.
# cp backend/.env.example backend/.env

# ─── Servidor ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ─── Threads Scraping ───────────────────────────────────────────
# Intervalo entre scrapeos automáticos (minutos)
THREADS_SCRAPE_INTERVAL_MINUTES=60

# Playwright (OPCIONAL — si lo instalas. En 512MB es mejor no hacerlo)
# PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_TIMEOUT_MS=30000

# Rate limiting
MIN_DELAY_BETWEEN_REQUESTS=2.0
MAX_DELAY_BETWEEN_REQUESTS=5.0
MAX_RETRIES=3

# Proxy (opcional)
# PROXY_URL=http://user:pass@host:port

# ─── Meta API (OPCIONAL — requiere App aprobada por Meta) ──────
# Si no tienes token, el scraper salta Estrategia 1 automáticamente
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=

# ─── LLM Scraper (RECOMENDADO — Groq es gratis, sin tarjeta) ──
# Regístrate: https://console.groq.com
# Provider: groq (gratis), openai, openai_large
LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_tu_key_aqui
# OPENAI_API_KEY=sk-tu_key_aqui
# LLM_API_KEY= (fallback si OPENAI/GROQ no están seteadas)
LLM_SCRAPER_TIMEOUT=60

# ─── Google APIs (OPCIONAL — para Search Console y Analytics) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# SITE_URL=sc-domain:elespectador.com
